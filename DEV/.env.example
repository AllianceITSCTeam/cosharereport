# Environment Variables Example
# Copy to .env and fill in values

# Database — readonly Postgres role on the CoShare database.
# This app never writes to the DB (see apps/api/src/prisma/prisma.service.ts).
DATABASE_URL="postgresql://readonly_user:password@localhost:5432/coshare"

# Shared secret CoShare uses to sign the SSO token (HS256).
# Confirm the exact signing algorithm/secret with the CoShare team.
COSHARE_JWT_SECRET="change-me-shared-with-coshare"

# Secret this app uses to sign its own session cookie after a successful /sso exchange.
SESSION_JWT_SECRET="change-me-local-session-secret"

# Path to redirect to after a successful /sso exchange (defaults to "/").
SSO_REDIRECT_PATH="/"

# CoShare OAuth2 password-grant endpoint used by the BFF login (POST /api/auth/login).
# Code falls back to these defaults if unset. Ask CoShare for a dedicated app_name/client
# for the report app instead of reusing "CoShareAdmin" (see docs/requirements/sso-integration/).
COSHARE_OAUTH_TOKEN_URL="https://api-adm.coshare.vn/oauth2/token"
COSHARE_OAUTH_APP_NAME="CoShareAdmin"

# TEMPORARY: set to "true" to skip the sign-in check (both the backend guard
# and the frontend session check) while SSO with a real CoShare token is not
# yet wired up. Never set this in production.
DISABLE_AUTH=false

# App
PORT=3000
NODE_ENV=development
# Must match apps/web/vite.config.ts's dev server port.
CORS_ORIGIN="http://localhost:5390"
